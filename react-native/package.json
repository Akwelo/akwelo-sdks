{
  "name": "@akwelo/react-native",
  "version": "0.1.0",
  "description": "Akwelo identity verification for React Native (hosted selfie capture in a WebView).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akwelo/akwelo-sdks.git",
    "directory": "react-native"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.76.5",
    "react-native-webview": "^13.12.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
